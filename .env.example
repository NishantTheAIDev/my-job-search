# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# Comma-separated company slugs for Greenhouse and Lever board APIs.
# The slug is the company identifier used in the board URL, e.g.:
#   https://boards.greenhouse.io/stripe  →  slug is "stripe"
#   https://jobs.lever.co/netflix        →  slug is "netflix"
# Not every company uses both boards — wrong slugs return 404 and are skipped.
# Verified working examples (as of 2026-05):
GREENHOUSE_COMPANIES=anthropic,databricks,stripe,figma
LEVER_COMPANIES=netflix

# Defaults (override if needed)
# DATABASE_URL=sqlite:///./data/jobsearch.db
# RESUME_STORAGE_DIR=./data/resumes
# LOG_LEVEL=INFO

# Server binding (defaults to localhost-only; set HOST=0.0.0.0 for network access)
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true

# CORS — comma-separated allowed origins (default: Vite dev server)
# CORS_ORIGINS=["http://localhost:5173"]