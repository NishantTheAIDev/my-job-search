# Copy this file to .env and fill in your values.
# Lines starting with # are comments. Uncomment optional entries to enable them.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key — powers resume tailoring, JD scoring, and cover-letter drafting.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Job board credentials
# ---------------------------------------------------------------------------

# Adzuna — free official REST API.
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# JSearch (RapidAPI) — aggregates LinkedIn, Indeed, Glassdoor, and more.
# Subscribe at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_rapidapi_key

# The Muse — free public API; key is optional but raises rate limits.
# Register at https://www.themuse.com/developers/api/v2
# THEMUSE_API_KEY=your_api_key

# ---------------------------------------------------------------------------
# Company board slugs (no auth required — free public APIs)
# ---------------------------------------------------------------------------

# Greenhouse: slug is the company identifier in the board URL.
#   https://boards.greenhouse.io/stripe  →  slug is "stripe"
# Comma-separated; wrong or retired slugs return 404 and are silently skipped.
# Verified working examples (as of 2026-05):
GREENHOUSE_COMPANIES=anthropic,databricks,stripe,figma

# Lever: slug is the company identifier in the job URL.
#   https://jobs.lever.co/netflix  →  slug is "netflix"
# Comma-separated; not every company uses Lever.
LEVER_COMPANIES=netflix

# ---------------------------------------------------------------------------
# Adapters that need no credentials (always active)
# ---------------------------------------------------------------------------
# LinkedIn         — public guest search, no auth
# Indeed           — public GraphQL endpoint, no auth
# Remotive         — free public API, no auth (max ~4 req/day; remote-only)
# Arbeitnow        — free public API, no auth (EU/international listings)
# Jobicy           — free public API, no auth (remote-only listings)
# We Work Remotely — public RSS feed, no auth (remote-only listings)

# ---------------------------------------------------------------------------
# Storage and server (optional overrides)
# ---------------------------------------------------------------------------

# DATABASE_URL=sqlite:///./data/jobsearch.db
# RESUME_STORAGE_DIR=./data/resumes
# LOG_LEVEL=INFO

# Server binding — set HOST=0.0.0.0 to expose on the local network
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true

# CORS — comma-separated allowed origins (default: Vite dev server)
# CORS_ORIGINS=["http://localhost:5173"]